<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>io.github.kotlinmania.kotlin-cpp</id>

    <name>Kotlin-Cpp</name>

    <vendor url="https://github.com/KotlinMania">KotlinMania</vendor>

    <description><![CDATA[
        Deterministic, language-level Kotlin-to-C++23 mechanical transliterator.<br>
        Grounded on KotlinMania's pure-KMP <em>antlr4-kotlin</em> specification grammar and universal <em>syn-kotlin</em> / <em>proc-macro2-kotlin</em> token stream.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="MyToolWindow" factoryClass="io.github.kotlinmania.kotlincpp.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
    </extensions>

    <actions resource-bundle="messages.MyMessageBundle">
        <action id="io.github.kotlinmania.kotlin-cpp.ConvertKotlinToCpp"
                class="io.github.kotlinmania.kotlincpp.ConvertKotlinToCppAction"
                icon="AllIcons.Actions.Compile">
            <add-to-group group-id="CodeMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <synonym key="action.io.github.kotlinmania.kotlin-cpp.ConvertKotlinToCpp.synonym"/>
            <abbreviation value="k2cpp"/>
        </action>
    </actions>
</idea-plugin>
